# ──────────────────────────────────────────
# Astral Agent — Environment Variables
# Solo necesitás esta key para correr el backend
# ──────────────────────────────────────────

# OpenAI API key (platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# ──────────────────────────────────────────
# Modelos OpenAI por endpoint.
#
# Cada endpoint del backend usa un modelo independiente. Permite tunear
# costo/calidad por uso sin tocar código. Cambiar requiere redeploy.
#
# Cheatsheet de pricing (mayo 2026, por 1M tokens):
#   gpt-4o-mini  →  $0.15 input  / $0.60 output
#   gpt-4o       →  $2.50 input  / $10.00 output    (17x más caro)
# ──────────────────────────────────────────

# CHAT_MODEL — conversación con la usuaria (path v1 + v2).
# Default mini: con tools deterministas (path v2) iguala a 4o en accuracy
# de HD a 1/17 del costo. Subir a gpt-4o solo si la calidad medida cae.
CHAT_MODEL=gpt-4o-mini

# MEMORY_WRITER_MODEL — extrae hechos del chat y los persiste en
# users.memory_md después de cada N turns (fire-and-forget, background).
# No es visible al usuario. Tarea simple (resumir ~6 mensajes → markdown).
# Mini sobra. NO subir salvo que la calidad del memory se vuelva problema.
MEMORY_WRITER_MODEL=gpt-4o-mini

# REPORT_MODEL — genera el informe HD personalizado (free + premium tier).
# Texto largo pero estructurado por secciones. Mini con prompts buenos
# alcanza. Si la usuaria pide un reporte premium de mayor calidad, evaluar
# subir a gpt-4o aquí en lugar de en el chat.
REPORT_MODEL=gpt-4o-mini

# EXTRACTION_MODEL — FALLBACK ONLY. El flujo productivo de extracción de
# bodygraph HD es 100% DETERMINÍSTICO (parser PDF con pdfjs-dist + regex,
# ver extractProfileFromAssets en extraction-service.ts líneas 630-664).
# Esta var solo se usa si llega un asset que NO es PDF de MyHumanDesign /
# Genetic Matrix (path legacy con Vision). Default gpt-4o porque si el
# fallback se invoca, queremos calidad alta — pero hoy NO genera costo
# real en producción. Si en el futuro se reactiva soporte de imágenes,
# este es el knob para cambiar el proveedor de Vision.
EXTRACTION_MODEL=gpt-4o

# Cuántos mensajes del historial mandar al LLM por turn. memory_md cubre los
# hechos persistentes; lo más viejo del historial deja de aportar señal y
# come tokens.
CHAT_HISTORY_TURNS=60

# Server port (opcional, default 3000)
PORT=3000

# Production CORS allowlist. En dev se permite cualquier origin para Vite.
FRONTEND_ORIGIN=https://your-frontend-domain.example

# Local asset storage fallback for development when R2_* is not configured.
ASSET_STORAGE_DIR=.local-assets

# SuperTokens managed auth surface.
# En dev con Vite proxy, el public-facing origin sigue siendo 5173.
SUPERTOKENS_CONNECTION_URI=https://try.supertokens.com
SUPERTOKENS_API_KEY=
SUPERTOKENS_APP_NAME="Astral Guide"
SUPERTOKENS_API_DOMAIN=http://localhost:5173
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:5173
SUPERTOKENS_API_BASE_PATH=/auth
SUPERTOKENS_WEBSITE_BASE_PATH=/auth
SUPERTOKENS_DASHBOARD_API_KEY=

# Optional: branded passwordless emails via your own SMTP provider.
# If you set any of these, provide the full set required below.
SUPERTOKENS_SMTP_HOST=
SUPERTOKENS_SMTP_PORT=
SUPERTOKENS_SMTP_USERNAME=
SUPERTOKENS_SMTP_PASSWORD=
SUPERTOKENS_SMTP_SECURE=false
SUPERTOKENS_EMAIL_FROM=
SUPERTOKENS_EMAIL_FROM_NAME="Astral Guide"
SUPERTOKENS_EMAIL_SUPPORT_HREF=mailto:hello@astral.guide?subject=Astral%20Guide%20Support

# Remote MCP OAuth discovery/token validation. No son secretos.
# Default local/off. En Render Staging, usar:
#   FEATURE_REMOTE_MCP=true
#   MCP_RESOURCE_URL=https://astral.soydanielamedina.com/api/mcp/v1
#   MCP_AUTHORIZATION_SERVER_ISSUER=https://thoughtful-trinket-33-staging.authkit.app
#   WORKOS_API_KEY=sk_... # secret; configure only in Render/dashboard
# MCP_RESOURCE_URL debe coincidir con el Resource Indicator configurado en WorkOS.
FEATURE_REMOTE_MCP=false
MCP_RESOURCE_URL=https://astral.soydanielamedina.com/api/mcp/v1
MCP_AUTHORIZATION_SERVER_ISSUER=https://thoughtful-trinket-33-staging.authkit.app
# WORKOS_API_KEY=
